{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../../src/**/*.ts"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../src/runtime",
    "../../src/transformer"
  ]
}
