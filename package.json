{
  "name": "draft-ole",
  "version": "0.2.0",
  "description": "Type-safe HTML/CSS/JS generation DSL library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc",
    "demo:mvp": "node --experimental-strip-types examples/mvp-demo.ts"
  },
  "keywords": [
    "typescript",
    "html",
    "css",
    "javascript",
    "dsl",
    "type-safe",
    "code-generation",
    "static-site-generator",
    "web-development",
    "ssg",
    "template-engine"
  ],
  "author": "Kazuyuki Shimizu <kazuyukishimizu@me.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/object-zaseeta/DraftOle.git"
  },
  "bugs": {
    "url": "https://github.com/object-zaseeta/DraftOle/issues"
  },
  "homepage": "https://github.com/object-zaseeta/DraftOle#readme",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^4.0.18"
  }
}
